{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "estudos-ia design tokens. Source of truth for code stays packages/ui/src/styles/globals.css; this file mirrors it for design tools.",
  "color": {
    "light": {
      "background": { "$type": "color", "$value": "#F2F4F1" },
      "surface": { "$type": "color", "$value": "#FBFCFB" },
      "surface-sunken": { "$type": "color", "$value": "#E9ECE8" },
      "foreground": { "$type": "color", "$value": "#17212B" },
      "muted-foreground": { "$type": "color", "$value": "#57626C" },
      "line": { "$type": "color", "$value": "#D3D9D4" },
      "line-strong": { "$type": "color", "$value": "#AEB7B1" },
      "accent": { "$type": "color", "$value": "#2A47C2" },
      "accent-foreground": { "$type": "color", "$value": "#FFFFFF" },
      "accent-soft": { "$type": "color", "$value": "#E3E8FA" },
      "success": { "$type": "color", "$value": "#1C7548" },
      "success-soft": { "$type": "color", "$value": "#DDEFE4" },
      "warning": { "$type": "color", "$value": "#8F5600" },
      "warning-soft": { "$type": "color", "$value": "#F6E9CF" },
      "danger": { "$type": "color", "$value": "#B4271F" },
      "danger-soft": { "$type": "color", "$value": "#F8E0DD" },
      "focus": { "$type": "color", "$value": "#2A47C2" },
      "highlight": { "$type": "color", "$value": "#FFE35A" },
      "highlight-ink": { "$type": "color", "$value": "#3D3200" }
    },
    "dark": {
      "background": { "$type": "color", "$value": "#11161B" },
      "surface": { "$type": "color", "$value": "#192027" },
      "surface-sunken": { "$type": "color", "$value": "#0C1014" },
      "foreground": { "$type": "color", "$value": "#E3E8E5" },
      "muted-foreground": { "$type": "color", "$value": "#98A3AB" },
      "line": { "$type": "color", "$value": "#2A343D" },
      "line-strong": { "$type": "color", "$value": "#44505A" },
      "accent": { "$type": "color", "$value": "#93A8FF" },
      "accent-foreground": { "$type": "color", "$value": "#0E1630" },
      "accent-soft": { "$type": "color", "$value": "#1F2A52" },
      "success": { "$type": "color", "$value": "#62CB93" },
      "success-soft": { "$type": "color", "$value": "#163626" },
      "warning": { "$type": "color", "$value": "#E8B657" },
      "warning-soft": { "$type": "color", "$value": "#3A2C10" },
      "danger": { "$type": "color", "$value": "#FF8F85" },
      "danger-soft": { "$type": "color", "$value": "#45191A" },
      "focus": { "$type": "color", "$value": "#B9C6FF" },
      "highlight": { "$type": "color", "$value": "#E8CC45" },
      "highlight-ink": { "$type": "color", "$value": "#2B2400" }
    }
  },
  "font": {
    "reading": { "$type": "fontFamily", "$value": ["Literata", "Georgia", "serif"], "$description": "Module content, notes, review questions, page titles" },
    "ui": { "$type": "fontFamily", "$value": ["IBM Plex Sans", "system-ui", "sans-serif"], "$description": "Navigation, buttons, labels, metadata" },
    "code": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "Markdown textarea, timer digits, counts, shortcuts" }
  },
  "fontSize": {
    "xs": { "$type": "dimension", "$value": "12px", "$description": "line-height 1.4" },
    "sm": { "$type": "dimension", "$value": "14px", "$description": "line-height 1.45" },
    "base": { "$type": "dimension", "$value": "15px", "$description": "UI base, line-height 1.5" },
    "lg": { "$type": "dimension", "$value": "17px", "$description": "Prose, line-height 1.7, max 68ch" },
    "xl": { "$type": "dimension", "$value": "20px", "$description": "line-height 1.35" },
    "2xl": { "$type": "dimension", "$value": "24px", "$description": "line-height 1.25" },
    "3xl": { "$type": "dimension", "$value": "30px", "$description": "Review question, line-height 1.2" },
    "4xl": { "$type": "dimension", "$value": "38px", "$description": "Page title, line-height 1.15" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "4px", "$description": "Buttons, inputs, checkboxes, segmented items" },
    "surface": { "$type": "dimension", "$value": "8px", "$description": "Cards, panels, tables" },
    "large": { "$type": "dimension", "$value": "12px" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Badges, step markers" }
  },
  "layout": {
    "page": { "$type": "dimension", "$value": "1120px", "$description": "Header, Today, map, module, sessions, routines" },
    "reading": { "$type": "dimension", "$value": "680px", "$description": "Module reading column" },
    "focus": { "$type": "dimension", "$value": "720px", "$description": "Review, import" },
    "header": { "$type": "dimension", "$value": "56px" },
    "touchTarget": { "$type": "dimension", "$value": "44px" }
  },
  "shadow": {
    "floating-light": { "$type": "shadow", "$value": "0 8px 24px rgb(23 33 43 / 0.12)" },
    "floating-dark": { "$type": "shadow", "$value": "0 8px 24px rgb(0 0 0 / 0.4)" },
    "dock-light": { "$type": "shadow", "$value": "0 -8px 24px rgb(23 33 43 / 0.08)" },
    "dock-dark": { "$type": "shadow", "$value": "0 -8px 24px rgb(0 0 0 / 0.35)" }
  },
  "motion": {
    "duration": { "$type": "duration", "$value": "150ms", "$description": "Only in response to an action; disabled under prefers-reduced-motion" },
    "easing": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] }
  }
}
