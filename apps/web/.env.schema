# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
DATABASE_URL=

# Password lock (HTTP Basic Auth on every page and /api/trpc).
# Leave APP_PASSWORD empty to turn the lock off (local dev). Use a long
# random value: varlock fails any response that contains a sensitive value.
# @optional @sensitive
APP_PASSWORD=

# User for the password lock; only checked when APP_PASSWORD is set.
# Not sensitive on purpose: a short sensitive value would trip varlock's
# leak scanner on every page that happens to contain it.
# @optional @sensitive=false
APP_USER=luis
